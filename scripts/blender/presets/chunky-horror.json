{
  "preset": "chunky-horror",
  "$comment": "Chunky cartoon proportions, dark co-op horror colours: dull painted body, near-black rubber and iron, rust trim, one warm indicator. Body stays under the saturation cap so the accent is the only thing that reads as colour.",
  "roles": {
    "body":     { "rgb": [0.400, 0.390, 0.310], "roughness": 0.78 },
    "body2":    { "rgb": [0.075, 0.070, 0.062], "roughness": 0.85 },
    "trim":     { "rgb": [0.210, 0.120, 0.070], "roughness": 0.70 },
    "accent":   { "rgb": [0.950, 0.560, 0.120], "roughness": 0.45 },
    "emissive": { "rgb": [0.980, 0.420, 0.080], "roughness": 0.45 }
  },
  "rules": {
    "min_luminance_contrast_body_body2": 0.30,
    "max_saturation_body": 0.40,
    "min_saturation_accent": 0.60,
    "roughness_range": [0.35, 0.90]
  }
}
